// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      String   @default("USER") // ADMIN or USER
  employee  Employee?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Employee {
  id               String   @id @default(uuid())
  employeeId       String   @unique
  firstNameEn      String
  lastNameEn       String
  firstNameKh      String?
  lastNameKh       String?
  gender           String
  dob              DateTime?
  position         String
  department       String
  line             String?  // New field
  shift            String?  // New field (e.g. N.T)
  phone            String?
  hireDate         DateTime
  basicSalary      Float
  maritalStatus    String   @default("SINGLE") // SINGLE, MARRIED
  spouse           Boolean  @default(false)    // New field (Wife)
  numberOfChildren Int      @default(0)
  photoUrl         String?  // New field (Profile Photo)
  annualLeaveDays  Float    @default(18)       // Annual leave allowance
  telegramChatId   String?  // Personal Telegram ID for Payslips

  // --- New fields for Employee Master Form ---
  cardNo             String?
  nationalId         String?
  bankCardNo         String?
  
  probationStart     DateTime?
  probationEnd       DateTime?
  
  regularContract1   DateTime?
  regularContract2   DateTime?
  regularContract3   DateTime?
  
  basicSalary1       Float?
  basicSalary2       Float?
  basicSalary3       Float?
  
  skillAllowance1    Float?
  skillAllowance2    Float?
  skillAllowance3    Float?
  
  positionAllowance1 Float?
  positionAllowance2 Float?
  positionAllowance3 Float?
  
  placeOfBirth       String?
  nationality        String?  @default("Cambodian")
  address            String?
  education          String?
  healthBook         String?
  healthCertificate  String?
  nssfNo             String?
  spouseName         String?
  remark             String?
  // -------------------------------------------

  status           String   @default("ACTIVE") // ACTIVE, TERMINATED, ALUMNI
  terminations     Termination[]
  userId           String?  @unique
  user             User?    @relation(fields: [userId], references: [id])
  leaveRequests    LeaveRequest[]
  advances         AdvanceSalary[]
  attendances      MonthlyAttendance[]
  dailyAttendances DailyAttendance[]
  payrolls         Payroll[]
  kpis             Kpi[]
  documents        EmployeeDocument[]
  assets           CompanyAsset[]
  expenseClaims    ExpenseClaim[]
  trainings        TrainingEnrollment[]
  rosters          ShiftRoster[]
  disciplinaryActions DisciplinaryAction[]
  appraisals       PerformanceAppraisal[]
  exitInterviews   ExitInterview[]
  overtimeRequests OvertimeRequest[]
  certificateRequests CertificateRequest[]
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Termination {
  id                  String   @id @default(uuid())
  employeeId          String
  employee            Employee @relation(fields: [employeeId], references: [id])
  
  terminationDate     DateTime
  contractType        String   // FDC, UDC
  reason              String   // NO_OFFENSE, SERIOUS_OFFENSE, CLOSURE, RESIGNATION
  noticeGiven         Boolean  @default(true)
  
  // Final Settlement Breakdown
  unpaidWages         Float    @default(0)
  annualLeavePay      Float    @default(0)
  severancePay        Float    @default(0) // For FDC 5%
  noticePay           Float    @default(0) // If notice not given
  seniorityIndemnity  Float    @default(0)
  damagesPay          Float    @default(0) // ជំងឺចិត្ត
  
  // Deductions
  unpaidAdvances      Float    @default(0)
  assetDeductions     Float    @default(0)
  otherDeductions     Float    @default(0)
  
  totalFinalPay       Float    @default(0)
  
  status              String   @default("PENDING") // PENDING, APPROVED, PAID
  remarks             String?
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model DailyAttendance {
  id            String   @id @default(uuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id])
  date          DateTime
  fIn           String?
  fOut          String?
  sIn           String?
  sOut          String?
  otIn          String?
  otOut         String?
  regDay        Float    @default(0)
  workHrs       Float    @default(0)
  normalOtHrs   Float    @default(0)
  nightOtHrs    Float    @default(0)
  holidayOtHrs  Float    @default(0)
  lateMins      Int      @default(0)
  earlyMins     Int      @default(0)
  remarks       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([employeeId, date])
}

model MonthlyAttendance {
  id            String   @id @default(uuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id])
  month         Int
  year          Int
  daysWorked    Float    @default(26)
  absentDays    Float    @default(0)
  leaveDays     Float    @default(0)
  otHours       Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([employeeId, month, year])
}

model Payroll {
  id                  String   @id @default(uuid())
  employeeId          String
  employee            Employee @relation(fields: [employeeId], references: [id])
  month               Int
  year                Int
  basicSalary         Float    @default(0)
  basicPayScale       Float    @default(0)
  workingDays         Float    @default(0)
  absentDays          Float    @default(0)
  permissionDays      Float    @default(0)
  workingSalary       Float    @default(0)
  payScaleIncentive   Float    @default(0)
  otHours             Float    @default(0)
  otWage              Float    @default(0)
  sunOtHours          Float    @default(0)
  sunOtWage           Float    @default(0)
  nightOtHours        Float    @default(0)
  nightOtWage         Float    @default(0)
  annualLeaveAmount   Float    @default(0)
  attendanceBonus     Float    @default(0)
  transportation      Float    @default(0)
  lunchAllowance      Float    @default(0)
  otMealAllowance     Float    @default(0)
  dayCareAllowance    Float    @default(0)
  seniority           Float    @default(0)
  seniorityIndemnity  Float    @default(0)
  productionIncentive Float    @default(0)
  adjustmentSkill     Float    @default(0)
  otherAllowance      Float    @default(0)
  otherAllowanceDesc  String?
  totalSalary         Float    @default(0)
  severancePay        Float    @default(0)
  taxPayment          Float    @default(0)
  loanPension         Float    @default(0)
  unionDeduction      Float    @default(0)
  nssf                Float    @default(0)
  netSalaryUsd        Float    @default(0)
  paidSalaryUsd       Float    @default(0)
  netSalaryRiel       Float    @default(0)
  exchangeRate        Float    @default(4000)
  status              String   @default("DRAFT") // DRAFT, APPROVED, PAID
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([employeeId, month, year])
}

model CompanySettings {
  id                String   @id @default("default")
  companyName       String   @default("HRM System")
  logoUrl           String?
  hrContactUrl      String?  @default("https://i.pravatar.cc/100?img=5")
  shiftMornIn       String   @default("07:00")
  shiftMornOut      String   @default("11:00")
  shiftAftIn        String   @default("13:00")
  shiftAftOut       String   @default("17:00")
  nightShiftMornIn  String   @default("17:00")
  nightShiftMornOut String   @default("22:00")
  nightShiftAftIn   String   @default("23:00")
  nightShiftAftOut  String   @default("04:00")
  nightOtStart      String   @default("22:00")
  payment1StartDate Int      @default(1)
  payment1EndDate   Int      @default(15)
  payment2StartDate Int      @default(16)
  payment2EndDate   Int      @default(31)
  fontSize          String   @default("14px")
  fontFamily        String   @default("Khmer OS Siemreap")
  
  telegramBotToken  String?
  telegramChatId    String?
  contactPhone      String?
  telegramLink      String?
  telegramQrUrl     String?

  advanceMaxLimit           Float    @default(50)
  advanceEligibilityMonths  Int      @default(3)
  advanceRepaymentPolicy    String   @default("NEXT_PAYROLL")

  updatedAt         DateTime @updatedAt
}

model LeaveRequest {
  id          String   @id @default(uuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])
  leaveType   String   // e.g. "ANNUAL", "SICK", "UNPAID", "MATERNITY"
  startDate   DateTime
  endDate     DateTime
  duration    Float    @default(1)
  reason      String?
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AdvanceSalary {
  id          String   @id @default(uuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])
  amount      Float
  requestDate DateTime
  month       Int
  year        Int
  reason      String?
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED, DEDUCTED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Kpi {
  id              String   @id @default(uuid())
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id])
  docDate         DateTime
  kpiType         String
  description     String?
  measurePercent  String?
  target          String?
  actual          Float    @default(0)
  tsStart         String?
  tsEnd           String?
  tsTotalHours    Float?
  tsRemark        String?
  tsFileUrl       String?
  status          String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model MasterKpi {
  id          String   @id @default(uuid())
  department  String
  kpiType     String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DepartmentGroup {
  id        String   @id @default(uuid())
  name      String   @unique
  color     String   @default("#e3f2fd")
  textColor String   @default("#1565c0")
  keywords  String   // comma-separated list of keywords
  orderIdx  Int      @default(0) // For sorting the display order
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmployeeDocument {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  title      String
  type       String   @default("OTHER") // ID_CARD, CONTRACT, CERTIFICATE, CV, OTHER
  fileUrl    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model CompanyAsset {
  id              String    @id @default(uuid())
  assetCode       String?   @unique
  itemType        String?
  employeeId      String?
  employee        Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  serialNumber    String?
  uom             String    @default("Unit")
  qtyInList       Int       @default(1)
  counting        Int?
  variance        Int?
  quality         String?
  imageUrl        String?   @db.Text
  assignDate      DateTime  @default(now())
  returnDate      DateTime?
  status          String    @default("IN_USE") // IN_USE, RETURNED, LOST, DAMAGED
  remarks         String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Document {
  id          String   @id @default(cuid())
  title       String
  category    String   @default("Policy")
  description String?
  fileData    String?  @db.Text
  fileUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ExpenseClaim {
  id          String   @id @default(uuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])
  date        DateTime
  category    String
  amount      Float
  currency    String   @default("USD")
  description String?
  receiptUrl  String?
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// --- Recruitment & ATS Models ---

model JobPosting {
  id              String       @id @default(uuid())
  title           String
  department      String
  location        String
  type            String       @default("FULL_TIME") // FULL_TIME, PART_TIME, CONTRACT, INTERNSHIP
  description     String       @db.Text
  requirements    String?      @db.Text
  status          String       @default("OPEN") // OPEN, CLOSED, DRAFT
  closingDate     DateTime?
  candidates      Candidate[]
  
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model Candidate {
  id              String       @id @default(uuid())
  jobPostingId    String
  jobPosting      JobPosting   @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  firstName       String
  lastName        String
  email           String
  phone           String?
  resumeUrl       String?      @db.Text
  coverLetter     String?      @db.Text
  status          String       @default("NEW") // NEW, REVIEWING, INTERVIEWING, OFFERED, HIRED, REJECTED
  appliedAt       DateTime     @default(now())
  
  notes           String?      @db.Text
  rating          Int?         
  
  updatedAt       DateTime     @updatedAt
}

// --- Training & Development Models ---

model TrainingProgram {
  id              String                @id @default(uuid())
  title           String
  description     String?               @db.Text
  trainer         String?               // Trainer name or Institute
  location        String?               // Online, Head Office, Training Center...
  startDate       DateTime
  endDate         DateTime
  cost            Float                 @default(0)
  status          String                @default("UPCOMING") // UPCOMING, ONGOING, COMPLETED, CANCELLED
  enrollments     TrainingEnrollment[]

  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
}

model TrainingEnrollment {
  id              String          @id @default(uuid())
  trainingId      String
  training        TrainingProgram @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  
  status          String          @default("ENROLLED") // ENROLLED, COMPLETED, FAILED, DROPPED
  score           Float?
  feedback        String?         @db.Text
  certificateUrl  String?         @db.Text
  enrolledAt      DateTime        @default(now())
  completedAt     DateTime?
  
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([trainingId, employeeId])
}

// --- Shift Rostering & Scheduling Models ---

model ShiftRoster {
  id          String   @id @default(uuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date        DateTime
  shiftType   String   @default("MORNING") // MORNING, AFTERNOON, NIGHT, OFF
  startTime   String?
  endTime     String?
  notes       String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([employeeId, date])
}

// --- Disciplinary Actions & Warning Letters ---

model DisciplinaryAction {
  id              String    @id @default(uuid())
  employeeId      String
  employee        Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  
  actionType      String    @default("WRITTEN_WARNING") // VERBAL_WARNING, WRITTEN_WARNING, SUSPENSION, TERMINATION, OTHER
  incidentDate    DateTime
  subject         String
  reason          String    // ATTENDANCE, MISCONDUCT, NEGLIGENCE, POLICY_VIOLATION, SAFETY, OTHER
  description     String?   @db.Text
  actionTaken     String?   @db.Text
  issuedBy        String?
  status          String    @default("ACTIVE") // ACTIVE, RESOLVED, APPEALED
  documentUrl     String?   @db.Text
  warningCount    Int       @default(1)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// --- Performance Appraisal & Review Models ---

model PerformanceAppraisal {
  id                  String    @id @default(uuid())
  employeeId          String
  employee            Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  
  period              String    // e.g. "2026 Q1", "2026 Annual"
  reviewDate          DateTime  @default(now())
  reviewerName        String    @default("HR / Dept Manager")
  
  // 5 Evaluation Pillars (0-100)
  workQualityScore    Float     @default(80)
  productivityScore   Float     @default(80)
  teamworkScore       Float     @default(80)
  skillKnowledgeScore Float     @default(80)
  disciplineScore     Float     @default(80)
  
  overallScore        Float     @default(80)
  grade               String    @default("B") // A, B, C, D, F
  
  strengths           String?   @db.Text
  improvements        String?   @db.Text
  recommendation      String?   @default("MAINTAIN") // PROMOTION, SALARY_INCREMENT, TRAINING, WARNING, MAINTAIN
  remarks             String?   @db.Text
  
  status              String    @default("SUBMITTED") // DRAFT, SUBMITTED, APPROVED, ACKNOWLEDGED
  
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([employeeId, period])
}

// --- Resignation & Exit Interview Models ---

model ExitInterview {
  id                  String    @id @default(uuid())
  employeeId          String
  employee            Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  
  resignationDate     DateTime  @default(now())
  lastWorkingDate     DateTime
  primaryReason       String    @default("CAREER_GROWTH") // BETTER_OFFER, CAREER_GROWTH, WORK_ENVIRONMENT, MANAGEMENT, PERSONAL_FAMILY, RELOCATION, HEALTH, OTHER
  reasonDetails       String?   @db.Text
  
  // Feedback Ratings (1 - 5 stars)
  cultureRating       Int       @default(4)
  managementRating    Int       @default(4)
  salaryBenefitRating Int       @default(3)
  workEnvRating       Int       @default(4)
  growthOppRating     Int       @default(3)
  
  wouldRecommend      Boolean   @default(true)
  handoverPerson      String?
  handoverNotes       String?   @db.Text
  
  // Clearance Checklist
  itClearance         Boolean   @default(false)
  financeClearance    Boolean   @default(false)
  adminClearance      Boolean   @default(false)
  hrClearance         Boolean   @default(false)
  
  interviewerName     String?   @default("HR Department")
  feedbackNotes       String?   @db.Text
  status              String    @default("PENDING") // PENDING, CLEARANCE_IN_PROGRESS, COMPLETED, CANCELLED
  
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

// --- Overtime (OT) Request & Approval Models ---

model OvertimeRequest {
  id              String    @id @default(uuid())
  employeeId      String
  employee        Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  
  otDate          DateTime
  startTime       String    // e.g. "17:30"
  endTime         String    // e.g. "20:30"
  totalHours      Float     @default(1.0)
  otType          String    @default("REGULAR_OT") // REGULAR_OT, NIGHT_OT, SUNDAY_OT, HOLIDAY_OT
  rateMultiplier  Float     @default(1.5)
  reason          String    // Project, Urgency, Line Workload, etc.
  notes           String?   @db.Text
  
  status          String    @default("PENDING") // PENDING, APPROVED, REJECTED, CANCELLED
  approvedBy      String?   // Manager / HR
  approvedAt      DateTime?
  rejectionReason String?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// --- Employee Certificate & Official Letter Models ---

model CertificateRequest {
  id              String    @id @default(uuid())
  employeeId      String
  employee        Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  
  certificateType String    @default("EMPLOYMENT_CERTIFICATE") // EMPLOYMENT_CERTIFICATE, SALARY_CERTIFICATE, INTERNSHIP_CERTIFICATE, EXPERIENCE_LETTER
  requestDate     DateTime  @default(now())
  purpose         String    // Bank Loan, Embassy Visa, Rental, Job Application, Other
  addressee       String?   // e.g. "To Whom It May Concern", "ជូនចំពោះ..."
  status          String    @default("PENDING") // PENDING, APPROVED, ISSUED, REJECTED
  issuedDate      DateTime?
  issuedBy        String?   @default("HR Department")
  referenceNo     String    @unique
  notes           String?   @db.Text
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// --- Company Announcements & Broadcast Models ---

model CompanyAnnouncement {
  id              String    @id @default(uuid())
  title           String
  content         String    @db.Text
  category        String    @default("GENERAL") // GENERAL, HOLIDAY, URGENT, EVENT, POLICY
  targetDept      String    @default("ALL") // ALL or Department name
  priority        String    @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  isPinned        Boolean   @default(false)
  effectiveDate   DateTime  @default(now())
  expiryDate      DateTime?
  authorName      String    @default("Management / HR")
  attachmentUrl   String?   @db.Text
  viewsCount      Int       @default(0)
  status          String    @default("PUBLISHED") // DRAFT, PUBLISHED, ARCHIVED
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}






