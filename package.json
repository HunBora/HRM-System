{
  "name": "hrm-system",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.js",
  "author": "Mr.Hun Bora",
  "description": "HRM Enterprise Portal Desktop Application",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && prisma db push --accept-data-loss && next build",
    "start": "next start",
    "lint": "eslint",
    "electron:dev": "concurrently \"cross-env NODE_ENV=development next dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:start": "electron .",
    "dist:win": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.hrm.enterprise",
    "productName": "HRM Enterprise System",
    "copyright": "Copyright © 2026 Mr.Hun Bora",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "public/app-icon.ico",
      "public/app-icon-square.png"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/app-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "HRM Enterprise System"
    }
  },
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "html2canvas": "^1.4.1",
    "jose": "^6.2.10",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "khmer-chhankitek-calendar": "^1.2.1",
    "next": "16.2.10",
    "qrcode.react": "^4.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-grid-layout": "^1.4.4",
    "react-resizable": "^4.0.2",
    "react-select": "^5.10.2",
    "recharts": "^3.10.0",
    "sweetalert2": "^11.26.25",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@prisma/client": "^5.22.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-grid-layout": "^1.3.6",
    "@types/react-resizable": "^3.0.8",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "png-to-ico": "^3.0.2",
    "prisma": "^5.22.0",
    "typescript": "^5",
    "wait-on": "^9.5.1"
  }
}
